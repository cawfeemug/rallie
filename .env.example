# Copy this file to .env. Docker Compose reads it automatically.

# Port the app is served on (http://localhost:8080 by default).
PORT=8080

# Signs login tokens. Use a long random value, e.g. run: openssl rand -hex 32
# If left empty the server generates a temporary one and everyone is logged out on every restart.
JWT_SECRET=

# true = create the demo session DEMO42 and a demo host account on first start.
SEED_DEMO=true

# Only needed for: docker compose --profile tunnel up -d
TUNNEL_TOKEN=
